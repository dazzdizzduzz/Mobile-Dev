<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rectangle_1"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/signup"
        android:text="Sign Up"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:textSize="32dp"
        android:textStyle="bold"
        android:layout_margin="50dp"
        android:gravity="center"/>

    <EditText
        android:layout_width="match_parent"
        android:Layout_heibght="wrap_content"
        android:id="@+id/ussername"
        android:layout_below="@+id/signup"
        android:background="@drawable/degas_background"
        android:hint="Username"
        android:paddingLeft="10dp"
        android:textColorHint="@color/white"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:layout_margin="10dp"
        android:padding="20dp"
        android:drawableLeft="@drawable/degas_ganteng_parah"
        android:drawablePadding="20dp"
        tools:ignore="HardcodedText"
        android:layout_height="wrap_content" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/email"
        android:layout_below="@+id/ussername"
        android:background="@drawable/degas_background"
        android:hint="Email"
        android:textColorHint="@color/white"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:layout_margin="10dp"
        android:padding="20dp"
        android:drawableLeft="@drawable/degas_rajin_puaasa"
        android:drawablePadding="20dp"
        android:inputType="textPassword"/>


    <EditText
        android:id="@+id/password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/email"
        android:layout_margin="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/degas_background"
        android:drawableLeft="@drawable/degas_sangat_ganteng"
        android:drawablePadding="20dp"
        android:hint="Password"
        android:inputType="textPassword"
        android:padding="20dp"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:textColorHint="@color/white" />

    <EditText
        android:id="@+id/repasword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/password"
        android:layout_margin="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/degas_background"
        android:drawableLeft="@drawable/degas_sangat_ganteng"
        android:drawablePadding="20dp"
        android:hint="Confirm Password"
        android:inputType="textPassword"
        android:padding="20dp"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:textColorHint="@color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="*Forgot password"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:layout_below="@+id/repasword"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
"

    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/register"
        android:layout_below="@id/repasword"
        android:text="Register"
        android:backgroundTint="@color/design_default_color_secondary"
        android:layout_centerHorizontal="true"
        android:layout_margin="40dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Account"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:layout_above="@id/icon"

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/icon"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:layout_marginBottom="15dp">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="20dp"
            android:src="@drawable/facebook">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="20dp"
            android:src="@drawable/search">

        </ImageView>

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="20dp"
            android:src="@drawable/github">
        </ImageView>

    </LinearLayout>
